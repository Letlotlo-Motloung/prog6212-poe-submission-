@model OrganiserDashboardDto
@{
    ViewData["Title"] = "Organiser dashboard";
}

<div class="page-head">
    <div>
        <div class="eyebrow">Organiser</div>
        <h1 class="mb-0">Dashboard</h1>
        <p>A summary of every event you have created, its enrolments and the next dates on the calendar.</p>
    </div>
    <div class="inline">
        <a class="btn btn-light" href="/Organiser/Events">Manage events</a>
        <a class="btn btn-primary" href="/Organiser/CreateEvent">+ Create event</a>
    </div>
</div>

<div class="grid grid-4 mb-3">
    <div class="stat">
        <div class="icon">📋</div>
        <div class="label">Total events</div>
        <div class="value">@Model.TotalEvents</div>
        <div class="hint">Created by you</div>
    </div>
    <div class="stat teal">
        <div class="icon">📅</div>
        <div class="label">Upcoming</div>
        <div class="value">@Model.UpcomingEvents</div>
        <div class="hint">Still to take place</div>
    </div>
    <div class="stat amber">
        <div class="icon">👥</div>
        <div class="label">Enrolments</div>
        <div class="value">@Model.TotalEnrolments</div>
        <div class="hint">@Model.TotalParticipants unique participants</div>
    </div>
    <div class="stat rose">
        <div class="icon">🏅</div>
        <div class="label">Results published</div>
        <div class="value">@Model.ResultsPublished</div>
        <div class="hint">Visible to participants</div>
    </div>
</div>

@if (Model.Events.Count == 0)
{
    <div class="card">
        <div class="empty">
            <div class="emoji">🏁</div>
            <h3>No events yet</h3>
            <p>Create your first event, add its categories, and participants can start entering.</p>
            <a class="btn btn-primary" href="/Organiser/CreateEvent">Create your first event</a>
        </div>
    </div>
}
else
{
    <div class="grid grid-2" style="align-items:start;">
        <div class="card card-pad">
            <div class="section-title" style="margin-top:0;">
                <h2 class="mb-0">Next up</h2>
                <a class="btn btn-ghost btn-sm" href="/Organiser/Events">All events</a>
            </div>

            @if (Model.Upcoming.Count == 0)
            {
                <p class="muted mb-0">No upcoming events. All of your events have already taken place.</p>
            }
            else
            {
                <div class="stack">
                    @foreach (var e in Model.Upcoming.Take(5))
                    {
                        <div style="display:flex;justify-content:space-between;gap:14px;align-items:center;padding-bottom:14px;border-bottom:1px dashed var(--line);">
                            <div>
                                <b>@e.EventName</b><br />
                                <small class="muted">@e.EventDate.ToString("ddd dd MMM yyyy") &middot; @e.Location</small>
                            </div>
                            <div class="right">
                                <span class="badge badge-brand">@e.TotalEnrolments enrolled</span>
                                <div class="mt-1">
                                    <a class="btn btn-light btn-sm" href="/Organiser/Enrolments/@e.EventID">Enrolments</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card card-pad">
            <h2>Enrolments per event</h2>
            <p class="muted" style="font-size:.86rem;">Totals across every event you manage.</p>
            <div class="stack">
                @foreach (var e in Model.Events.OrderByDescending(x => x.TotalEnrolments).Take(6))
                {
                    var max = Math.Max(1, Model.Events.Max(x => x.TotalEnrolments));
                    var pct = (int)Math.Round(e.TotalEnrolments * 100.0 / max);
                    <div>
                        <div class="inline" style="justify-content:space-between;">
                            <span style="font-size:.88rem;font-weight:600;">@e.EventName</span>
                            <span class="muted" style="font-size:.82rem;">@e.TotalEnrolments</span>
                        </div>
                        <div class="progress"><span style="width:@pct%"></span></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="section-title">
        <h2 class="mb-0">All events</h2>
        <span class="badge badge-dark">@Model.Events.Count</span>
    </div>

    <div class="table-wrap">
        <div class="table-scroll">
            <table class="data">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Categories</th>
                        <th>Enrolments</th>
                        <th>Results</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Events.OrderBy(x => x.EventDate))
                    {
                        <tr>
                            <td><b>@e.EventName</b><br /><small class="muted">@e.Location</small></td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@e.CategoryCount</td>
                            <td>@e.TotalEnrolments</td>
                            <td>@e.ResultsCaptured</td>
                            <td><span class="badge @(e.IsPast ? "badge-dark" : "badge-green")">@(e.IsPast ? "Past" : "Upcoming")</span></td>
                            <td class="right">
                                <a class="btn btn-ghost btn-sm" href="/Organiser/Results/@e.EventID">Results</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
