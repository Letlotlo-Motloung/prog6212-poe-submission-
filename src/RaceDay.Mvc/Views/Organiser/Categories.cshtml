@model EventDetailsDto
@{
    ViewData["Title"] = "Categories — " + Model.EventName;
}

<div class="page-head">
    <div>
        <div class="eyebrow">Organiser &middot; @Model.EventName</div>
        <h1 class="mb-0">Categories</h1>
        <p>Add age or distance categories, set entry fees and capacity limits for this event.</p>
    </div>
    <div class="inline">
        <a class="btn btn-light" href="/Organiser/Enrolments/@Model.EventID">Enrolments</a>
        <a class="btn btn-ghost" href="/Organiser/Events">← Back to events</a>
    </div>
</div>

<div class="grid grid-2" style="align-items:start;">
    <div class="card card-pad">
        <h2>Add a category</h2>
        <p class="muted" style="font-size:.86rem;">Participants choose one of these categories when they enrol.</p>

        <form asp-action="AddCategory" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="eventId" value="@Model.EventID" />

            <div class="field">
                <label>Category name</label>
                <input name="CategoryName" class="input" placeholder="e.g. Senior Men / 21 km" required />
            </div>

            <div class="form-row">
                <div class="field">
                    <label>Category type</label>
                    <select name="CategoryType" class="select">
                        <option value="Distance">Distance</option>
                        <option value="Age">Age</option>
                    </select>
                </div>
                <div class="field">
                    <label>Distance (km)</label>
                    <input name="DistanceKM" class="input" type="number" step="0.1" min="0" value="@Model.DistanceKM.ToString("0.##")" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label>Maximum participants</label>
                    <input name="MaxParticipants" class="input" type="number" min="1" value="100" />
                </div>
                <div class="field">
                    <label>Entry fee (R)</label>
                    <input name="EntryFee" class="input" type="number" step="0.01" min="0" value="0" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Add category</button>
        </form>
    </div>

    <div class="card card-pad">
        <div class="section-title" style="margin-top:0;">
            <h2 class="mb-0">Existing categories</h2>
            <span class="badge badge-dark">@Model.Categories.Count</span>
        </div>

        @if (Model.Categories.Count == 0)
        {
            <div class="empty" style="padding:30px 10px;">
                <div class="emoji">🗂️</div>
                <h3>No categories yet</h3>
                <p>Add at least one category so participants can enrol.</p>
            </div>
        }
        else
        {
            <div class="stack">
                @foreach (var c in Model.Categories)
                {
                    <div style="border:1px solid var(--line);border-radius:12px;padding:14px;">
                        <form asp-action="EditCategory" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.EventID" />
                            <input type="hidden" name="CategoryID" value="@c.CategoryID" />

                            <div class="form-row">
                                <div class="field" style="margin-bottom:10px;">
                                    <label>Name</label>
                                    <input name="CategoryName" class="input" value="@c.CategoryName" required />
                                </div>
                                <div class="field" style="margin-bottom:10px;">
                                    <label>Type</label>
                                    <select name="CategoryType" class="select">
                                        <option value="Distance" selected="@(c.CategoryType == "Distance")">Distance</option>
                                        <option value="Age" selected="@(c.CategoryType == "Age")">Age</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="field" style="margin-bottom:10px;">
                                    <label>Distance (km)</label>
                                    <input name="DistanceKM" class="input" type="number" step="0.1" min="0" value="@c.DistanceKM.ToString("0.##")" />
                                </div>
                                <div class="field" style="margin-bottom:10px;">
                                    <label>Capacity</label>
                                    <input name="MaxParticipants" class="input" type="number" min="1" value="@c.MaxParticipants" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="field" style="margin-bottom:10px;">
                                    <label>Entry fee (R)</label>
                                    <input name="EntryFee" class="input" type="number" step="0.01" min="0" value="@c.EntryFee.ToString("0.00")" />
                                </div>
                                <div class="field" style="margin-bottom:10px;">
                                    <label>Enrolled</label>
                                    <input class="input" value="@c.EnrolmentCount of @c.MaxParticipants" disabled />
                                </div>
                            </div>

                            <div class="inline">
                                <button type="submit" class="btn btn-dark btn-sm">Save</button>
                                <span class="badge @(c.CategoryType == "Age" ? "badge-amber" : "badge-brand")">@c.CategoryType</span>
                            </div>
                        </form>

                        <form asp-action="DeleteCategory" method="post" class="mt-1 mb-0" data-confirm="Delete category '@c.CategoryName'?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.EventID" />
                            <input type="hidden" name="categoryId" value="@c.CategoryID" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete category</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
