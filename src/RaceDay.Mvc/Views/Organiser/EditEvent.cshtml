@model EventDto
@{
    ViewData["Title"] = "Edit event";
}

<div class="page-head">
    <div>
        <div class="eyebrow">Organiser</div>
        <h1 class="mb-0">Edit event</h1>
        <p>Update the event information. Existing categories, enrolments and results are preserved.</p>
    </div>
    <div class="inline">
        <a class="btn btn-light" href="/Organiser/Categories/@Model.EventID">Categories</a>
        <a class="btn btn-ghost" href="/Organiser/Events">← Back to events</a>
    </div>
</div>

<div class="card card-pad form-card">
    <form asp-action="EditEvent" asp-route-id="@Model.EventID" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="EventID" />
        <input type="hidden" asp-for="BannerUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="EventName">Event name</label>
            <input asp-for="EventName" class="input" />
            <span asp-validation-for="EventName" class="field-error"></span>
        </div>

        <div class="form-row">
            <div class="field">
                <label asp-for="EventDate">Event date</label>
                <input asp-for="EventDate" class="input" type="date" value="@Model.EventDate.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="EventDate" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="DistanceKM">Distance (km)</label>
                <input asp-for="DistanceKM" class="input" type="number" step="0.1" min="0.1" />
                <span asp-validation-for="DistanceKM" class="field-error"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label asp-for="Location">Location</label>
                <input asp-for="Location" class="input" />
                <span asp-validation-for="Location" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="EventType">Event type</label>
                <select asp-for="EventType" class="select">
                    <option value="Road Race">Road Race</option>
                    <option value="Trail Run">Trail Run</option>
                    <option value="Cycle Tour">Cycle Tour</option>
                    <option value="Fun Run">Fun Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Triathlon">Triathlon</option>
                </select>
                <span asp-validation-for="EventType" class="field-error"></span>
            </div>
        </div>

        <div class="field">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="textarea"></textarea>
        </div>

        <div class="field">
            <label asp-for="RouteInfo">Route information</label>
            <textarea asp-for="RouteInfo" class="textarea" style="min-height:80px;"></textarea>
        </div>

        <div class="field">
            <label>Replace banner image</label>
            <input type="file" name="banner" accept="image/*" class="file-input" data-preview="#bannerPreview" />
            <div class="hint">Leave empty to keep the current banner.</div>
            <div id="bannerPreview" style="margin-top:12px;height:140px;border-radius:12px;background-image:url('@Model.BannerUrl');background-size:cover;background-position:center;background-color:#eef0ff;"></div>
        </div>

        <div class="inline">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-ghost" href="/Organiser/Events">Cancel</a>
        </div>
    </form>
</div>
