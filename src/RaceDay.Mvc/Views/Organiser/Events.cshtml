@model List<OrganiserEventSummaryDto>
@{
    ViewData["Title"] = "My events";
}

<div class="page-head">
    <div>
        <div class="eyebrow">Organiser</div>
        <h1 class="mb-0">My events</h1>
        <p>Create, edit and remove events. From here you can also manage categories, enrolments and results.</p>
    </div>
    <a class="btn btn-primary" href="/Organiser/CreateEvent">+ Create event</a>
</div>

@if (ViewBag.ApiError != null)
{
    <div class="alert alert-error"><span>!</span><span>@ViewBag.ApiError</span></div>
}

@if (Model.Count == 0)
{
    <div class="card">
        <div class="empty">
            <div class="emoji">🗓️</div>
            <h3>No events created yet</h3>
            <p>Start by creating an event with a name, date, location, distance and optional banner image.</p>
            <a class="btn btn-primary" href="/Organiser/CreateEvent">Create event</a>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <div class="table-scroll">
            <table class="data">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Categories</th>
                        <th>Enrolments</th>
                        <th>Results</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.OrderByDescending(x => x.EventDate))
                    {
                        <tr>
                            <td>
                                <div class="inline" style="gap:10px;">
                                    @if (!string.IsNullOrEmpty(e.BannerUrl))
                                    {
                                        <img src="@e.BannerUrl" alt="" style="width:44px;height:44px;border-radius:8px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="width:44px;height:44px;border-radius:8px;display:grid;place-items:center;background:var(--brand-soft);">🏅</span>
                                    }
                                    <div>
                                        <b>@e.EventName</b><br />
                                        <small class="muted">@e.Location</small>
                                    </div>
                                </div>
                            </td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@(e.EventType ?? "—")</td>
                            <td>@e.CategoryCount</td>
                            <td>@e.TotalEnrolments</td>
                            <td>@e.ResultsCaptured</td>
                            <td><span class="badge @(e.IsPast ? "badge-dark" : "badge-green")">@(e.IsPast ? "Past" : "Upcoming")</span></td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-light btn-sm" href="/Organiser/Categories/@e.EventID">Categories</a>
                                    <a class="btn btn-light btn-sm" href="/Organiser/Enrolments/@e.EventID">Enrolments</a>
                                    <a class="btn btn-light btn-sm" href="/Organiser/Results/@e.EventID">Results</a>
                                    <a class="btn btn-ghost btn-sm" href="/Organiser/EditEvent/@e.EventID">Edit</a>
                                    <form asp-action="DeleteEvent" method="post" class="mb-0" data-confirm="Delete '@e.EventName'? This also removes its categories, enrolments and results.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.EventID" />
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
